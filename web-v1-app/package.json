{
  "name": "web-v1-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "check:repo-hygiene": "node scripts/repo-hygiene-check.mjs && node scripts/repo-scratch-file-check.mjs",
    "check:legal-copy": "node scripts/legal-copy-check.mjs",
    "cleanup:repo-artifacts": "node scripts/cleanup-repo-artifacts.mjs",
    "check:route-docs-sync": "node scripts/route-docs-sync-check.mjs",
    "check:launch-readiness": "node scripts/launch-readiness-check.mjs",
    "check:public-copy-guard": "node scripts/public-copy-guard.mjs",
    "check:api-contract": "node scripts/api-contract-audit.mjs",
    "check:calculation-correctness": "node scripts/calculation-correctness-audit.mjs",
    "check:field-dictionary-sync": "node scripts/check-field-dictionary-sync.mjs",
    "check:pipeline-determinism": "node scripts/pipeline-determinism-inventory.mjs",
    "check:pipeline-golden-fixture": "node scripts/pipeline-golden-fixture.mjs",
    "check:pipeline-meta-golden-fixture": "node scripts/pipeline-meta-golden-fixture.mjs",
    "check:methodology-version": "node scripts/methodology-version-enforcement.mjs",
    "check:published-json-schemas": "node scripts/published-json-schema-contracts.mjs",
    "check:published-atomicity": "node scripts/published-atomicity-gate.mjs",
    "check:source-failure-handling": "node scripts/source-failure-handling-gate.mjs",
    "check:timeout-retry-policy": "node scripts/timeout-retry-policy-gate.mjs",
    "check:pipeline-environment-parity": "node scripts/pipeline-environment-parity-inventory.mjs",
    "check:native-pipeline": "node scripts/native-pipeline-ci-command.mjs",
    "qa:internal-launch": "npm run check:repo-hygiene && npm run check:route-docs-sync && npm run check:launch-readiness && npm run check:public-copy-guard && npm run check:api-contract && npm run check:calculation-correctness && npm run check:field-dictionary-sync && npm run lint && npm run typecheck && npm run test && npm run build",
    "check:publication-integrity": "node scripts/publication-integrity-audit.mjs",
    "check:audit-gates": "node scripts/run-audit-gates.mjs",
    "check:audit-gates:no-build": "node scripts/run-audit-gates.mjs --skip-build",
    "check:billing-launch": "node scripts/run-billing-launch-gate.mjs",
    "check:production-health": "node scripts/production-healthcheck.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.876.0",
    "@clerk/nextjs": "^6.0.0",
    "@prisma/client": "^6.19.2",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.35.3",
    "next": "16.2.6",
    "prisma": "^6.19.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "stripe": "^18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.27",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "zod": "^4.1.8"
  },
  "overrides": {
    "zod-validation-error": "3.5.3",
    "next": {
      "postcss": "8.5.10"
    }
  }
}
