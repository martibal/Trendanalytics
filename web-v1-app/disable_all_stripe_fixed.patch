+/**
+ * @jest-environment node
+ */
+
+export {};
+
+jest.mock("next/server", () => ({
+  NextResponse: {
+    json: (body: unknown, init?: { status?: number }) => ({
+      status: init?.status ?? 200,
+      async json() {
+        return body;
+      },
+    }),
+  },
+}));
+
+type MockJsonResponse = {
+  status: number;
+  json: () => Promise<unknown>;
+};
+
+let postRoute: (request: Request) => Promise<MockJsonResponse>;
+
+describe("billing-disabled route", () => {
+  beforeEach(async () => {
+    jest.resetModules();
+    const routeModule = await import("@/app/api/v1/checkout/portal/route");
+    postRoute = routeModule.POST as unknown as (
+      request: Request
+    ) => Promise<MockJsonResponse>;
+  });
+
+  it("returns 503 while the billing portal is intentionally disabled", async () => {
+    const request = new Request("http://localhost:3000/api/v1/checkout/portal", {
+      method: "POST",
+    });
+
+    const response = await postRoute(request);
+    const payload = (await response.json()) as {
+      code: string;
+      message: string;
+      detail: string | null;
+    };
+
+    expect(response.status).toBe(503);
+    expect(payload.code).toBe("portal_disabled");
+    expect(payload.message).toBe("Billing portal is temporarily unavailable.");
+    expect(payload.detail).toBe(
+      "Payments are disabled while business registration and live billing setup are being completed."
+    );
+  });
+});
