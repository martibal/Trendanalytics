+// src/components/landing/CheckoutButton.tsx
+//
+// Prelaunch state: all Stripe checkout entry points are intentionally disabled
+// until business registration and production billing setup are complete.
+
+import { useState } from "react";
+
+type Plan = "basic" | "pro" | "history_addon";
+
+type CheckoutButtonProps = {
+  plan: Plan;
+  className?: string;
+  children: React.ReactNode;
+};
+
+const DISABLED_LABEL: Record<Plan, string> = {
+  basic: "Payments open soon",
+  pro: "Payments open soon",
+  history_addon: "Payments open soon",
+};
+
+export default function CheckoutButton({ plan, className }: CheckoutButtonProps) {
+  const [showNotice, setShowNotice] = useState(false);
+
+  return (
+    <div>
+      <button
+        type="button"
+        onClick={() => setShowNotice(true)}
+        aria-disabled="true"
+        className={className}
+      >
+        {DISABLED_LABEL[plan]}
+      </button>
+
+      {showNotice ? (
+        <p className="mt-2 max-w-sm text-xs leading-5 text-amber-300/90">
+          Payments are temporarily unavailable while business registration and live billing setup are being completed.
+        </p>
+      ) : null}
+    </div>
+  );
+}
