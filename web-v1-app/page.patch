-function classifyStatus(params: {
-  chain: ChainId;
-  lagDays: number | null;
-  asOf: string | null;
-}): StatusApiRow["status"] {
-  const { chain, lagDays, asOf } = params;
-  if (!asOf || lagDays === null) return "unknown";
-  const expected = expectedDelayDays(chain);
-  if (lagDays <= expected) return "ok";
-  if (lagDays <= expected + 2) return "warn";
-  return "fail";
-}
