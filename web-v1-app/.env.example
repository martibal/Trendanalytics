# Runtime environment template for Trendanalytics web-v1-app.
# Copy values into the deployment platform secret store. Do not commit real secrets.

# App URL
# Production must use the public HTTPS origin that Stripe redirects back to.
NEXT_PUBLIC_APP_URL=https://example.com
APP_URL=https://example.com
VERCEL_PROJECT_PRODUCTION_URL=example.com

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=clerk_publishable_key_from_secret_store
CLERK_SECRET_KEY=clerk_secret_value_from_secret_store

# Stripe
# Use a Stripe live mode secret key in production.
# Use a Stripe test mode secret key only in local/dev/preview environments.
STRIPE_SECRET_KEY=stripe_secret_key_from_secret_store

# Price IDs must match the Basic and Pro subscription prices in the active Stripe account.
STRIPE_PRICE_BASIC=price_basic_subscription_id
STRIPE_PRICE_PRO=price_pro_subscription_id

# This value must come from the exact Stripe Dashboard webhook endpoint
# configured for /api/v1/stripe/webhook in the same environment.
STRIPE_WEBHOOK_SECRET=stripe_webhook_secret_from_secret_store

# Upstash / Redis rate limiting
UPSTASH_REDIS_REST_URL=https://example-upstash-url
UPSTASH_REDIS_REST_TOKEN=upstash_token_from_secret_store

# Storage
STORAGE_BACKEND=local
S3_REGION=eu-north-1
S3_BUCKET=trendanalytics-private-artifacts
S3_ACCESS_KEY_ID=aws_access_key_from_secret_store
S3_SECRET_ACCESS_KEY=aws_secret_access_key_from_secret_store

# D-065 Stripe billing mode guard
# Production checkout and production Stripe webhooks require STRIPE_SECRET_KEY to use live secret key mode.
# Local and preview environments may use Stripe test key mode for verification.

# D-068 Checkout redirect URL boundary
# Production Stripe Checkout redirects must use an explicitly configured app URL.
# Set NEXT_PUBLIC_APP_URL or APP_URL to the canonical production origin, for example https://urdatlas.com.
# Local development may fall back to the request origin.
