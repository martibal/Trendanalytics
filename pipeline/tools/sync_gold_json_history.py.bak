#!/usr/bin/env python3
"""
Sync gold parquet -> per-day JSON history (and latest/last30d) for the UI.

This file may live under either:
  - <repo>/tools/
  - <repo>/pipeline/tools/

To make it robust, repo root is detected by walking upwards until we find
both "api" and "web" directories (the stable repo markers in this project).

Outputs default to:
  GOLD_ROOT:      <repo>/pipeline/_work/prod/gold   (or env GOLD_ROOT)
  GOLD_JSON_ROOT: <repo>/data/calculated/gold      (or env GOLD_JSON_ROOT)
"""

from __future__ import annotations

import argparse
import json
import os
from dataclasses import dataclass
from datetime import date
from pathlib import Path
from typing import Any, Dict, Iterable, Optional

import pandas as pd


def _find_repo_root(start: Path) -> Path:
    """
    Walk upward from `start` until we find a directory that looks like the repo root.
    Repo root markers (stable in this project): 'api' and 'web' folders.
    """
    start = start.resolve()
    for p in [start] + list(start.parents):
        if (p / "api").is_dir() and (p / "web").is_dir():
            return p
    # Fallback: two levels up (best effort)
    return start.parents[1]


def _repo_root() -> Path:
    # __file__ == .../<repo>/tools/sync_gold_json_history.py OR .../<repo>/pipeline/tools/sync_gold_json_history.py
    here = Path(__file__).resolve()
    return _find_repo_root(here.parent)


def _as_date(x: Any) -> Optional[date]:
    if x is None:
        return None
    if isinstance(x, date):
        return x
    try:
        return date.fromisoformat(str(x))
    except Exception:
        return None


def _json_safe(v: Any) -> Any:
    """Convert common pandas/numpy scalar types to plain Python for json.dumps."""
    try:
        if pd.isna(v):
            return None
    except Exception:
        pass
    if hasattr(v, "item"):
        try:
            return v.item()
        except Exception:
            pass
    return v


def _write_json(path: Path, obj: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(obj, ensure_ascii=False), encoding="utf-8")


@dataclass(frozen=True)
class SyncConfig:
    repo_root: Path
    gold_root: Path
    out_root: Path


def _default_gold_root(repo_root: Path) -> Path:
    # In "main" layout, gold parquet is produced under pipeline/_work/prod/gold
    return repo_root / "pipeline" / "_work" / "prod" / "gold"


def _default_out_root(repo_root: Path) -> Path:
    return repo_root / "data" / "calculated" / "gold"


def _pick_latest_date(df: pd.DataFrame) -> Optional[str]:
    if "date" not in df.columns:
        return None
    dts = df["date"].dropna()
    if dts.empty:
        return None
    # Accept both datetime/date/iso strings
    ds = [_as_date(x) for x in dts.tolist()]
    ds = [x for x in ds if x is not None]
    if not ds:
        return None
    return max(ds).isoformat()


def _iter_rows(df: pd.DataFrame) -> Iterable[Dict[str, Any]]:
    # Ensure deterministic column order
    cols = list(df.columns)
    for _, row in df.iterrows():
        obj: Dict[str, Any] = {}
        for c in cols:
            obj[c] = _json_safe(row[c])
        yield obj


def sync_chain(cfg: SyncConfig, chain: str) -> int:
    gold_parquet = cfg.gold_root / f"{chain}.parquet"
    if not gold_parquet.exists():
        print(f"[SYNC] {chain}: missing parquet: {gold_parquet}")
        return 0

    df = pd.read_parquet(gold_parquet)
    if df.empty:
        print(f"[SYNC] {chain}: empty parquet: {gold_parquet}")
        return 0

    # Normalize date column to ISO strings
    if "date" in df.columns:
        df["date"] = df["date"].apply(lambda x: _as_date(x).isoformat() if _as_date(x) else None)

    # Per-day files
    wrote = 0
    latest = None
    if "date" in df.columns:
        for d, sub in df.groupby("date"):
            if not d:
                continue
            out = cfg.out_root / chain / f"{d}.json"
            # Many rows/day should not happen, but keep as list if it does
            rows = list(_iter_rows(sub))
            payload = rows[0] if len(rows) == 1 else rows
            _write_json(out, payload)
            wrote += 1
        latest = _pick_latest_date(df)

    # latest.json
    if latest:
        latest_row = df[df["date"] == latest].tail(1)
        if not latest_row.empty:
            out_latest = cfg.out_root / chain / "latest.json"
            _write_json(out_latest, next(_iter_rows(latest_row)))
    # last30d.json (based on last 30 unique dates)
    if "date" in df.columns:
        dates = sorted([d for d in df["date"].dropna().unique().tolist() if d])
        last_dates = dates[-30:]
        df30 = df[df["date"].isin(last_dates)]
        out30 = cfg.out_root / chain / "last30d.json"
        _write_json(out30, list(_iter_rows(df30)))

    if latest:
        print(f"[SYNC] {chain}: wrote {wrote} day-file(s), latest={latest}")
    else:
        print(f"[SYNC] {chain}: wrote {wrote} day-file(s)")
    return wrote


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--repo-root", default="", help="Override repo root (optional)")
    ap.add_argument("--gold-root", default="", help="Override gold parquet root (optional)")
    ap.add_argument("--out-root", default="", help="Override output JSON root (optional)")
    ap.add_argument("--chains", default="bitcoin,ethereum,arbitrum,base", help="Comma-separated chain list")
    args = ap.parse_args()

    rr = Path(args.repo_root).resolve() if args.repo_root else _repo_root()

    gold_root = Path(args.gold_root).resolve() if args.gold_root else Path(os.environ.get("GOLD_ROOT", str(_default_gold_root(rr)))).resolve()
    out_root = Path(args.out_root).resolve() if args.out_root else Path(os.environ.get("GOLD_JSON_ROOT", str(_default_out_root(rr)))).resolve()

    cfg = SyncConfig(repo_root=rr, gold_root=gold_root, out_root=out_root)

    print(f"[SYNC] repo_root      = {cfg.repo_root}")
    print(f"[SYNC] gold_root      = {cfg.gold_root} (realpath: {Path(os.path.realpath(cfg.gold_root))})")
    print(f"[SYNC] gold_json_root = {cfg.out_root} (realpath: {Path(os.path.realpath(cfg.out_root))})")

    if not cfg.gold_root.exists():
        print(f"[SYNC] gold_root missing: {cfg.gold_root}")
        return 1

    chains = [c.strip() for c in str(args.chains).split(",") if c.strip()]
    total = 0
    for c in chains:
        total += sync_chain(cfg, c)

    print("[SYNC] Done.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
